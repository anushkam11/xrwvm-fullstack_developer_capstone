FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY server/frontend/package*.json ./
RUN npm ci
COPY server/frontend/ ./
RUN npm run build

FROM node:22-bookworm-slim AS dealership-api
WORKDIR /build
COPY server/database/package*.json ./
RUN npm ci --omit=dev

FROM mongo:7.0-jammy
ENV PATH="/opt/python/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    DJANGO_DEBUG=0 \
    DJANGO_ALLOWED_HOSTS=".codeengine.appdomain.cloud,localhost,127.0.0.1" \
    DJANGO_DB_PATH=/tmp/capstone.sqlite3 \
    backend_url=http://127.0.0.1:3030 \
    sentiment_analyzer_url=http://127.0.0.1:5050
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-venv curl \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/python
WORKDIR /app
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node
COPY server/requirements.txt ./requirements.txt
COPY server/djangoapp/microservices/requirements.txt ./sentiment-requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -r sentiment-requirements.txt
COPY server/ ./
COPY --from=frontend /build/build ./frontend/build
COPY --from=dealership-api /build/node_modules ./database/node_modules
RUN DJANGO_DEBUG=1 python manage.py collectstatic --noinput
EXPOSE 8080
USER mongodb
ENTRYPOINT ["bash", "/app/start-codeengine.sh"]
CMD []
